# ===========================================
# Payos Contract Deployment Environment
# ===========================================

PRIVATE_KEY=your_private_key_here

# ===========================================
# RPC URLs for Testnets
# ===========================================

# OP Sepolia
OP_SEPOLIA_RPC_URL=infura_or_alchemy_rpc

# Base Sepolia  
BASE_SEPOLIA_RPC_URL=infura_or_alchemy_rpc

# Polygon Sepolia
POLYGON_AMOY_RPC_URL=infura_or_alchemy_rpc

# Arbitrum Sepolia
ARB_SEPOLIA_RPC_URL=infura_or_alchemy_rpc

# Ethereum Sepolia
ETH_SEPOLIA_RPC_URL=infura_or_alchemy_rpc

# ===========================================
# Block Explorer API Keys (for verification)
# ===========================================

ETHERSCAN_API_KEY=your_etherscan_api_key

# ===========================================
# Gas Configuration (optional)
# ===========================================

# Gas price multiplier (1.0 = normal, 1.1 = 10% higher)
GAS_MULTIPLIER=1.0

# Gas limit for deployment (default: 8000000)
GAS_LIMIT=8000000

# ===========================================
# Deployment Configuration
# ===========================================

# Verify contracts after deployment (true/false)
VERIFY_CONTRACTS=true

# Save deployment artifacts (true/false)
SAVE_DEPLOYMENTS=true

# Deployment timeout in seconds (default: 300)
DEPLOYMENT_TIMEOUT=300
